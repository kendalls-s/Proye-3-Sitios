{
  "info": {
    "name": "Core1 - Listado de Puestos (Microservicio REST)",
    "description": "Pruebas del microservicio Core1.\n\nHU Core1: retorna el listado de puestos activos (disponible = 1), indicando su código y su nombre.\n\nComo usar:\n1. Arranca el proyecto SRV_Core1_ListadoPuestos (dotnet run o F5). Queda en http://localhost:5200.\n2. Si tu puerto es otro, cambia la variable baseUrl.\n3. El servicio no requiere autenticacion.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5200",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Listado de puestos activos - 200",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/puestos-activos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "puestos-activos"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "var body = pm.response.json();",
              "pm.test('Envoltorio success/statusCode/message/data', function () {",
              "  pm.expect(body.success).to.eql(true);",
              "  pm.expect(body.statusCode).to.eql(200);",
              "  pm.expect(body).to.have.property('message');",
              "  pm.expect(body.data).to.be.an('array');",
              "});",
              "pm.test('Cada puesto trae codigo y nombre', function () {",
              "  if (body.data.length > 0) {",
              "    pm.expect(body.data[0]).to.have.property('codigo');",
              "    pm.expect(body.data[0]).to.have.property('nombre');",
              "  }",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
