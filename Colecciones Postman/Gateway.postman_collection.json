                ]
              }
            }
          ]
        },
        {
          "name": "2.3 GET /gateway/core1/puestos-activos con token manipulado (firma invalida) - 401",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenManipulado}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/gateway/core1/puestos-activos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "gateway",
                "core1",
                "puestos-activos"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var tokenValido = pm.collectionVariables.get('token') || 'a.b.c';",
                  "var partes = tokenValido.split('.');",
                  "var firmaOriginal = partes[2] || 'firma';",
                  "var firmaManipulada = firmaOriginal.split('').reverse().join('') + 'X';",
                  "var tokenManipulado = partes[0] + '.' + partes[1] + '.' + firmaManipulada;",
                  "pm.collectionVariables.set('tokenManipulado', tokenManipulado);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401 (firma JWT invalida)', function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ]
        },
        {
          "name": "2.4 GET /gateway/core1/puestos-activos con token expirado - 401",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenExpirado}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/gateway/core1/puestos-activos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "gateway",
                "core1",
                "puestos-activos"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Genera localmente un JWT ya vencido, firmado con la misma llave HS256",
                  "// configurada en appsettings.json (Jwt:Key), para no depender de esperar",
                  "// el vencimiento real del token. Si el sandbox de Postman no trae crypto-js,",
                  "// el test de este request se marca como omitido en vez de romper la corrida.",
                  "try {",
                  "  var CryptoJS = require('crypto-js');",
                  "",
                  "  function base64url(wordArray) {",
                  "    var base64 = CryptoJS.enc.Base64.stringify(wordArray);",
                  "    return base64.replace(/\\+/g, '-').replace(/\\//g, '_').replace(/=+$/, '');",
                  "  }",
                  "",
                  "  var header = { alg: 'HS256', typ: 'JWT' };",
                  "  var ahora = Math.floor(Date.now() / 1000);",
                  "  var payload = {",
                  "    sub: '1',",
                  "    unique_name: 'admin',",
                  "    iss: pm.collectionVariables.get('jwtIssuer'),",
                  "    aud: pm.collectionVariables.get('jwtAudience'),",
                  "    iat: ahora - 7200,",
                  "    exp: ahora - 3600",
                  "  };",
                  "",
                  "  var headerB64 = base64url(CryptoJS.enc.Utf8.parse(JSON.stringify(header)));",
                  "  var payloadB64 = base64url(CryptoJS.enc.Utf8.parse(JSON.stringify(payload)));",
                  "  var data = headerB64 + '.' + payloadB64;",
                  "",
                  "  var key = CryptoJS.enc.Utf8.parse(pm.collectionVariables.get('jwtKey'));",
                  "  var firma = base64url(CryptoJS.HmacSHA256(data, key));",
                  "",
                  "  pm.collectionVariables.set('tokenExpirado', data + '.' + firma);",
                  "  pm.collectionVariables.set('tokenExpiradoOk', 'true');",
                  "} catch (e) {",
                  "  console.log('No se pudo generar el token expirado localmente: ' + e.message);",
                  "  pm.collectionVariables.set('tokenExpirado', 'token.invalido.sinfirma');",
                  "  pm.collectionVariables.set('tokenExpiradoOk', 'false');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.collectionVariables.get('tokenExpiradoOk') === 'true') {",
                  "  pm.test('Status 401 (token expirado, ValidateLifetime = true)', function () { pm.response.to.have.status(401); });",
                  "} else {",
                  "  pm.test.skip('No se pudo firmar el token expirado en este entorno de Postman (sin crypto-js); revisa manualmente.');",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
