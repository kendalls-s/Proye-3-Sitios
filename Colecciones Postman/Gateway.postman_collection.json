    {
      "name": "1. Login a traves del Gateway (ruta anonima)",
      "item": [
        {
          "name": "1.1 POST /gateway/auth/login - 200 (guarda token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"{{usuarioValido}}\",\n  \"password\": \"{{passwordValido}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/gateway/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "gateway",
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 (ruta Anonymous, no requiere token)', function () { pm.response.to.have.status(200); });",
                  "var body = pm.response.json();",
                  "pm.test('Envoltorio con token (proxy a Auth.Api /api/auth/login)', function () {",
                  "  pm.expect(body.success).to.eql(true);",
                  "  pm.expect(body.statusCode).to.eql(200);",
                  "  pm.expect(body.data.token).to.be.a('string').and.not.empty;",
                  "});",
                  "pm.collectionVariables.set('token', body.data.token);"
                ]
              }
            }
          ]
        },
